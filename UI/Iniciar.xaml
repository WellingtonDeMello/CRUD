<Window x:Class="UI.Iniciar"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cadastro"
        Height="500"
        Width="800"
        WindowStartupLocation="CenterScreen"
        Background="#F0F0F0">

    <Grid>

        <Grid.Background>
            <ImageBrush ImageSource="/1946477-abstrato-azul-e-laranja-moderno-escuro-fundo-gratis-vetor.jpg"/>
        </Grid.Background>

        <Border Background="White"
                CornerRadius="17"
                Margin="36,26,42,26">

            <Border.Effect>
                <DropShadowEffect BlurRadius="20"
                                  ShadowDepth="2"
                                  Opacity="0.2"/>
            </Border.Effect>

            <Grid Margin="0,-17,0,-16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="3*"/>
                </Grid.ColumnDefinitions>

                <!-- LADO ESQUERDO -->
                <Border Grid.Column="0"
                        Background="#FF6900"
                        CornerRadius="15,0,0,15" Grid.ColumnSpan="2" Margin="-15,18,433,16">

                    <StackPanel VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Margin="20">

                        <TextBlock Text="GESTEX"
                                   FontSize="26"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   Margin="0,0,0,30"
                                   HorizontalAlignment="Center"/>

                        <TextBlock Text="Bem vindo a Gestex!"
                                   FontSize="18"
                                   Foreground="White"
                                   FontWeight="Bold"
                                   TextAlignment="Center"
                                   Margin="0,0,0,10"/>

                        <TextBlock Text="A gestão que se adapta a você."
                                   Foreground="White"
                                   FontSize="12"
                                   TextAlignment="Center"
                                   Margin="0,0,0,25"/>

                        <Button x:Name="entrarButton" Content="ENTRAR"
                                Width="150"
                                Height="40"
                                Background="#FF6900"
                                Foreground="White"
                                FontWeight="Bold"
                                BorderBrush="White"
                                BorderThickness="1.5"
                                Click="entrarButton_Click">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="20"/>
                                </Style>
                            </Button.Resources>
                        </Button>

                    </StackPanel>
                </Border>

                <!-- LADO DIREITO -->
                <StackPanel Grid.Column="1"
            VerticalAlignment="Center"
            Margin="100,0,100,0">

                    <TextBlock Text="CRIE SUA CONTA"
               FontSize="22"
               FontWeight="Bold"
               Foreground="#1B1B1B"
               Margin="0,0,0,35"
               HorizontalAlignment="Center"/>

                    <!-- NOME -->
                    <Border CornerRadius="25"
            Background="DarkGray"
            BorderBrush="#D0D0D0"
            BorderThickness="1.5"
            Height="50"
            Margin="0,0,0,18">

                        <Grid Width="186" Margin="0,4,0,0" Background="DarkGray">
                            <TextBox x:Name="txtNome"
                     Foreground="Black"
                     Background="Transparent"
                     BorderThickness="0"
                     Padding="20,0"
                     FontSize="15"
                     VerticalContentAlignment="Center"
                     TextChanged="txtNome_TextChanged" Margin="-1,5,1,8"/>

                            <TextBlock x:Name="placeholderNome"
                       Text="Digite seu nome"
                       Foreground="Black"
                       Margin="16,4,6,0"
                       VerticalAlignment="Top"
                       IsHitTestVisible="False"/>
                        </Grid>
                    </Border>

                    <!-- EMAIL -->
                    <Border CornerRadius="25"
            Background="DarkGray"
            BorderBrush="#D0D0D0"
            BorderThickness="1.5"
            Height="50"
            Margin="0,0,0,18">

                        <Grid Background="DarkGray" Width="195" Margin="0,4,0,4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="31*"/>
                                <RowDefinition Height="8*"/>
                            </Grid.RowDefinitions>
                            <TextBox x:Name="txtEmail"
                     Foreground="#1B1B1B"
                     Background="Transparent"
                     BorderThickness="0"
                     Padding="20,0"
                     FontSize="15"
                     VerticalContentAlignment="Center"
                     TextChanged="txtEmail_TextChanged" Margin="0,4,0,5" Grid.RowSpan="2"/>

                            <TextBlock x:Name="placeholderEmail"
                       Text="Digite seu e-mail"
                       Foreground="Black"
                       Margin="22,6,0,0"
                       VerticalAlignment="Top"
                       IsHitTestVisible="False" Grid.RowSpan="2"/>
                        </Grid>
                    </Border>

                    <!-- SENHA -->
                    <Border CornerRadius="25"
            Background="DarkGray"
            BorderBrush="#D0D0D0"
            BorderThickness="1.5"
            Height="50"
            Margin="0,0,0,18">

                        <Grid Background="DarkGray" Width="196" Margin="0,6,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="135*"/>
                                <ColumnDefinition Width="10*"/>
                                <ColumnDefinition Width="51*"/>
                            </Grid.ColumnDefinitions>
                            <PasswordBox x:Name="txtSenha"
                         Foreground="#1B1B1B"
                         Background="DarkGray"
                         BorderThickness="0"
                         Padding="20,0"
                         FontSize="15"
                         VerticalContentAlignment="Center"
                         PasswordChanged="txtSenha_PasswordChanged" Margin="0,4,27,0" Grid.ColumnSpan="3"/>

                            <TextBlock x:Name="placeholderSenha"
                       Text="Digite sua senha"
                       Foreground="Black"
                       Margin="22,0,18,0"
                       VerticalAlignment="Center"
                       IsHitTestVisible="False" Grid.ColumnSpan="3"/>
                        </Grid>
                    </Border>

                    <!-- REPETIR SENHA -->
                    <Border CornerRadius="25"
            Background="DarkGray"
            BorderBrush="#D0D0D0"
            BorderThickness="1.5"
            Height="50"
            Margin="0,0,0,30" Width="218">

                        <Grid Background="DarkGray" Margin="14,10,4,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="167*"/>
                                <ColumnDefinition Width="51*"/>
                            </Grid.ColumnDefinitions>
                            <PasswordBox x:Name="txtRepetirSenha"
                         Foreground="#1B1B1B"
                         Background="DarkGray"
                         BorderThickness="0"
                         Padding="20,0"
                         FontSize="15"
                         VerticalContentAlignment="Center"
                         PasswordChanged="txtRepetirSenha_PasswordChanged" Margin="-7,1,13,5" Grid.ColumnSpan="2"/>

                            <TextBlock x:Name="placeholderRepetirSenha"
                       Text="Digite a senha novamente"
                       Foreground="Black"
                       Margin="-1,0,5,0"
                       VerticalAlignment="Center"
                       IsHitTestVisible="False" FontSize="16" Grid.ColumnSpan="2"/>
                        </Grid>
                    </Border>
                    <Button x:Name="btn_cadas"
        Content="CADASTRAR"
        Height="50"
        Background="#FF6900"
        Foreground="White"
        FontSize="15"
        FontWeight="Bold"
        Click="btnCadastro">

                        <Button.Resources>
                            <Style TargetType="{x:Type Border}">
                                <Setter Property="CornerRadius" Value="25"/>
                            </Style>
                        </Button.Resources>

                    </Button>



                </StackPanel>

            </Grid>
        </Border>

    </Grid>
</Window>