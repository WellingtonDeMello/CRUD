<Window x:Class="UI.Principal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStartupLocation="CenterScreen"
        MinHeight="720" MinWidth="1024"
        Height="720" Width="1024"
        Background="#F3F4F6">

    <!-- 🔥 ARREDONDAR TODOS OS BOTÕES -->
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="15"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>

        <!-- Layout principal -->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.ColumnSpan="2"
                Background="White"
                Padding="20">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="| Sistema de Gestão"
                           FontSize="22"
                           FontWeight="Bold"
                           VerticalAlignment="Top"
                           Grid.ColumnSpan="2"
                           Margin="70,7,-22,0"/>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">

                    <TextBlock Name="BoxUsuarioAtual"
                               VerticalAlignment="Center"
                               Margin="0,0,15,0"
                               FontWeight="SemiBold"/>
                </StackPanel>

                <Image HorizontalAlignment="Left"
                       Height="67"
                       Margin="-1,-12,0,0"
                       VerticalAlignment="Top"
                       Width="100"
                       Source="/ChatGPT Image 27 de jan. de 2026, 19_20_51.png"/>
            </Grid>
        </Border>

        <!-- SIDEBAR -->
        <Border Grid.Row="1"
                Background="#1F2937"
                Padding="15">

            <StackPanel>

                <Button
                    x:Name="BtnProdutos"
                    Content="Produtos"
                        Height="50"
                        Margin="0,10"
                        Background="#FF6900"
                        Foreground="White"
                        BorderThickness="0"
                        Click="MostrarProdutos"/>

                <Button 
                    x:Name="BtnVendas"
                    Content="Vendas"
                        Height="50"
                        Margin="0,10"
                        Background="#374151"
                        Foreground="White"
                        BorderThickness="0"
                        Click="MostrarVendas"/>

                <Button x:Name="BtnUsuarios"
        Content="Usuários"
        Height="50"
        Margin="0,10"
        Background="#374151"
        Foreground="White"
        BorderThickness="0"
        Click="MostrarUsuarios"/>

            </StackPanel>
        </Border>

        <Image HorizontalAlignment="Left"
               Height="632"
               VerticalAlignment="Top"
               Width="804"
               Source="/7b7910e2a8267f3a3d52d9120c551e58_processed.jpg"
               Margin="3,78,0,0"
               Grid.Column="1"
               Stretch="Fill"
               Grid.RowSpan="2"/>

        <!-- CONTEÚDO -->
        <Grid Grid.Row="1"
              Grid.Column="1"
              Margin="30">

            <Grid.RowDefinitions>
                <RowDefinition Height="23*"/>
                <RowDefinition Height="165*"/>
            </Grid.RowDefinitions>

            <!-- PRODUTOS -->
            <Border x:Name="PainelProdutos"
                    CornerRadius="15"
                    Padding="20"
                    Grid.RowSpan="2">

                <Border.Background>
                    <ImageBrush/>
                </Border.Background>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="324*"/>
                        <RowDefinition Height="137*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal"
                                Margin="0,0,0,20">

                        <Button Content="Cadastrar Produto"
                                Padding="20,8"
                                Margin="0,0,10,0"
                                Background="#FF6900"
                                Foreground="White"
                                BorderThickness="0"
                                Click="BtnCadastroProduto"
                                Width="210"/>

                        <Button Content="Editar Produto"
                                Padding="20,8"
                                Margin="0,0,10,0"
                                Background="#FF6900"
                                BorderThickness="0"
                                Click="btnEditarProduto" Foreground="White"/>

                        <Button Content="Excluir"
                                Padding="20,8"
                                Margin="0,0,10,0"
                                Background="#FFC11313"
                                BorderThickness="0"
                                Click="BtnExcluirProduto" Foreground="White"/>

                        <Button Content="Consulta"
                                Padding="20,8"
                                Background="#FF6900"
                                BorderThickness="0"
                                Click="BtnConsultarProduto"
                                Width="128" Foreground="White"/>
                    </StackPanel>

                    <DataGrid Name="gridProdutos"
                              Grid.Row="1"
                              AutoGenerateColumns="False"
                              Margin="0,0,1,0"
                              SelectedIndex="-1"
                              Grid.RowSpan="2">

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Código" Binding="{Binding Id}" Width="*"/>
                            <DataGridTextColumn Header="Descrição" Binding="{Binding Descricao}" Width="*"/>
                            <DataGridTextColumn Header="Unidade Medida" Binding="{Binding UnidadeDeMedida}" Width="1.7*"/>
                            <DataGridTextColumn Header="Grupo" Binding="{Binding ProdutoGrupo}" Width="*"/>
                            <DataGridTextColumn Header="Preço Custo" Binding="{Binding PrecoCusto}" Width="1.3*"/>
                            <DataGridTextColumn Header="Preço Venda" Binding="{Binding PrecoVenda}" Width="1.4*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <!-- VENDAS -->
            <Border x:Name="PainelVendas"
                    Background="White"
                    CornerRadius="15"
                    Padding="20"
                    Visibility="Collapsed"
                    Grid.RowSpan="2">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>

                    <StackPanel Orientation="Horizontal"
                                Margin="0,0,0,20">

                        <Button Content="Nova Venda"
                                Padding="20,8"
                                Margin="0,0,10,0"
                                Background="#FF6900"
                                Foreground="White"
                                BorderThickness="0"
                                Click="BtnNovaVendaDialog"/>

                        <Button Content="Consultar Vendas"
                                Padding="20,8"
                                Margin="0,0,10,0"
                                Background="#FF6900"
                                Foreground="White"
                                BorderThickness="0"
                                Click="BtnConsultarVenda"/>

                        <Button Content="Editar"
                                Padding="20,8"
                                Margin="0,0,10,0"
                                Background="#FF6900"
                                Foreground="White"
                                BorderThickness="0"
                                Click="editar"/>

                        <Button Content="Excluir"
                                Padding="20,8"
                                Background="#CC2828"
                                Foreground="White"
                                BorderThickness="0"
                                Click="BtnExcluir"/>
                    </StackPanel>

                    <DataGrid Name="gridVendas"
                              Grid.Row="1"
                              AutoGenerateColumns="False">

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Código" Binding="{Binding Id}" Width="*"/>
                            <DataGridTextColumn Header="Cliente" Binding="{Binding ClienteNome}" Width="*"/>
                            <DataGridTextColumn Header="CPF" Binding="{Binding ClienteDocumento}" Width="*"/>
                            <DataGridTextColumn Header="Total" Binding="{Binding Total}" Width="*"/>
                            <DataGridTextColumn Header="Data e Hora"
                                                Binding="{Binding DataHora, StringFormat=dd/MM/yyyy HH:mm:ss}"
                                                Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <Grid x:Name="PainelUsuarios" Visibility="Collapsed">

                <Grid.RowDefinitions>
                    <RowDefinition Height="70"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- BOTÕES -->
                <StackPanel Orientation="Horizontal" Margin="20">

                    <Button x:Name="BtnNovoUsuariopri"
        Content="Novo Usuário"
        Width="150"
        Height="45"
        Margin="0,0,10,0"
        Background="#FF6900"
        Foreground="White"
        FontWeight="Bold"
        BorderThickness="0"
        Cursor="Hand"
        Click="BtnNovoUsuario_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="20">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Button x:Name="BtnConsultarUsuariospri"
        Content="Consultar"
        Width="150"
        Height="45"
        Margin="0,0,10,0"
        Background="#FF6900"
        Foreground="White"
        FontWeight="Bold"
        BorderThickness="0"
        Cursor="Hand"
        Click="BtnConsultarUsuarios_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="20">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Button x:Name="BtnExcluirUsuariopri"
        Content="Excluir"
        Width="150"
        Height="45"
        Background="#C62828"
        Foreground="White"
        FontWeight="Bold"
        BorderThickness="0"
        Cursor="Hand"
        Click="BtnExcluirUsuario_Click">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="20">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                </StackPanel>


                <!-- GRID DE USUARIOS -->
                <DataGrid x:Name="gridUsuarios"
              Grid.Row="1"
              Margin="20"
              AutoGenerateColumns="False"
              Background="#2A2A2A"
              Foreground="White"
              BorderBrush="#3A3A3A"
              RowBackground="#2A2A2A"
              AlternatingRowBackground="#242424"
              GridLinesVisibility="None">

                    <DataGrid.Columns>

                        <DataGridTextColumn Header="ID"
                                Binding="{Binding Id}"
                                Width="80"/>

                        <DataGridTextColumn Header="Nome"
                                Binding="{Binding Nome}"
                                Width="*"/>

                        <DataGridTextColumn Header="Email"
                                Binding="{Binding Email}"
                                Width="*"/>

                        <DataGridTextColumn Header="Tipo"
                                Binding="{Binding TipoUsuario}"
                                Width="150"/>

                    </DataGrid.Columns>

                </DataGrid>

            </Grid>

       



        </Grid>
    </Grid>
</Window>