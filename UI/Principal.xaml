<Window x:Class="UI.Principal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStartupLocation="CenterScreen"
        MinHeight="720"
        MinWidth="1024"
        Height="720"
        Width="1024"
        Background="#F3F4F6">

    <Window.Resources>

        <Style TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="12"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <!-- HEADER -->
        <Border Grid.ColumnSpan="2"
                Background="White"
                Padding="20">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="| Gestex"
                           FontSize="22"
                           FontWeight="Bold"
                           VerticalAlignment="Center" Margin="0,0,256,0"/>

                <TextBlock x:Name="BoxUsuarioAtual"
                           Grid.Column="1"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"/>
                <Button Content="X"
        Grid.Column="2"
        Width="30"
        Height="30"
        Background="Red"
        Foreground="White"
        Margin="10,0,0,0"
        Click="Button_Click"/>

            </Grid>

        </Border>

        <!-- MENU -->
        <Border Grid.Row="1"
                Background="#1F2937"
                Padding="15">

            <StackPanel>

                <Button x:Name="BtnProdutos"
                        Content="Produtos"
                        Height="50"
                        Margin="0,10"
                        Background="#FF6900"
                        Click="MostrarProdutos"/>

                <Button x:Name="BtnVendas"
                        Content="Vendas"
                        Height="50"
                        Margin="0,10"
                        Background="#374151"
                        Click="MostrarVendas"/>

                <Button x:Name="BtnUsuarios"
                        Content="Usuários"
                        Height="50"
                        Margin="0,10"
                        Background="#374151"
                        Click="MostrarUsuarios"/>

                <Button x:Name="BtnFornecedores"
                        Content="Fornecedores"
                        Height="50"
                        Margin="0,10"
                        Background="#374151"
                        Click="MostrarFornecedores"/>

            </StackPanel>

        </Border>

        <!-- AREA PRINCIPAL -->
        <Grid Grid.Row="1"
              Grid.Column="1">
            <Grid.Background>
                <ImageBrush ImageSource="/1946477-abstrato-azul-e-laranja-moderno-escuro-fundo-gratis-vetor.jpg"/>
            </Grid.Background>

            <Grid Margin="30">

                <!-- ================= PRODUTOS ================= -->

                <Border x:Name="PainelProdutos"
                        Background="#CCFFFFFF"
                        CornerRadius="15"
                        Padding="20">

                    <Grid>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Orientation="Horizontal"
                                    Margin="0,0,0,20">

                            <Button Content="Cadastrar Produto"
                                    Padding="20,8"
                                    Margin="0,0,10,0"
                                    Background="#FF6900"
                                    Click="BtnCadastroProduto"/>

                            <Button Content="Editar Produto"
                                    Padding="20,8"
                                    Margin="0,0,10,0"
                                    Background="#FF6900"
                                    Click="btnEditarProduto"/>

                            <Button Content="Excluir"
                                    Padding="20,8"
                                    Margin="0,0,10,0"
                                    Background="#C11313"
                                    Click="BtnExcluirProduto"/>

                            <Button Content="Consulta"
                                    Padding="20,8"
                                    Background="#FF6900"
                                    Click="BtnConsultarProduto"/>

                        </StackPanel>

                        <DataGrid x:Name="gridProdutos"
                                  Grid.Row="1"
                                  AutoGenerateColumns="False">

                            <DataGrid.Columns>

                                <DataGridTextColumn Header="Código" Binding="{Binding Id}" Width="*"/>
                                <DataGridTextColumn Header="Descrição" Binding="{Binding Descricao}" Width="*"/>
                                <DataGridTextColumn Header="Unidade" Binding="{Binding UnidadeDeMedida}" Width="*"/>
                                <DataGridTextColumn Header="Grupo" Binding="{Binding ProdutoGrupo}" Width="*"/>
                                <DataGridTextColumn Header="Preço Custo" Binding="{Binding PrecoCusto}" Width="*"/>
                                <DataGridTextColumn Header="Preço Venda" Binding="{Binding PrecoVenda}" Width="*"/>

                            </DataGrid.Columns>

                        </DataGrid>

                    </Grid>

                </Border>

                <!-- ================= VENDAS ================= -->

                <Border x:Name="PainelVendas"
                        Background="#CCFFFFFF"
                        CornerRadius="15"
                        Padding="20"
                        Visibility="Collapsed">

                    <Grid>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="200"/>
                        </Grid.RowDefinitions>

                        <StackPanel Orientation="Horizontal"
                                    Margin="0,0,0,20">

                            <Button Content="Nova Venda"
                                    Padding="20,8"
                                    Margin="0,0,10,0"
                                    Background="#FF6900"
                                    Click="BtnNovaVendaDialog"/>

                            <Button Content="Consultar Vendas"
                                    Padding="20,8"
                                    Margin="0,0,10,0"
                                    Background="#FF6900"
                                    Click="BtnConsultarVenda"/>

                            <Button Content="Editar"
                                    Padding="20,8"
                                    Margin="0,0,10,0"
                                    Background="#FF6900"
                                    Click="editar"/>

                            <Button Content="Excluir"
                                    Padding="20,8"
                                    Background="#CC2828"
                                    Click="BtnExcluir"/>

                        </StackPanel>

                        <DataGrid x:Name="gridVendas"
                                  Grid.Row="1"
                                  AutoGenerateColumns="False"
                                  SelectionChanged="gridVendas_SelectionChanged">

                            <DataGrid.Columns>

                                <DataGridTextColumn Header="Código" Binding="{Binding Id}" Width="*"/>
                                <DataGridTextColumn Header="Cliente" Binding="{Binding ClienteNome}" Width="*"/>
                                <DataGridTextColumn Header="CPF" Binding="{Binding ClienteDocumento}" Width="*"/>
                                <DataGridTextColumn Header="Total" Binding="{Binding Total}" Width="*"/>
                                <DataGridTextColumn Header="Data" Binding="{Binding DataHora}" Width="*"/>

                            </DataGrid.Columns>

                        </DataGrid>

                        <Border Grid.Row="2"
                                Background="#F9FAFB"
                                CornerRadius="10"
                                Padding="10">

                            <DataGrid x:Name="gridVendaProdutos"
                                      AutoGenerateColumns="False">

                                <DataGrid.Columns>

                                    <DataGridTextColumn Header="Produto" Binding="{Binding Produto.Descricao}" Width="*"/>
                                    <DataGridTextColumn Header="Preço" Binding="{Binding PrecoVenda}" Width="*"/>
                                    <DataGridTextColumn Header="Quantidade" Binding="{Binding Quantidade}" Width="*"/>
                                    <DataGridTextColumn Header="Total" Binding="{Binding Total}" Width="*"/>

                                </DataGrid.Columns>

                            </DataGrid>

                        </Border>

                    </Grid>

                </Border>

                <!-- ================= USUÁRIOS ================= -->

                <Grid x:Name="PainelUsuarios" Visibility="Collapsed">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <!-- TABELA -->
                    <DataGrid x:Name="gridUsuarios"
              AutoGenerateColumns="False"
              Margin="0,0,20,0">

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="80"/>
                            <DataGridTextColumn Header="Nome" Binding="{Binding Nome}" Width="*"/>
                            <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="*"/>
                            <DataGridTextColumn Header="Tipo" Binding="{Binding TipoUsuario}" Width="120"/>
                        </DataGrid.Columns>

                    </DataGrid>

                    <!-- FORMULÁRIO -->
                    <Border Grid.Column="1"
            Background="White"
            CornerRadius="10"
            Padding="20">

                        <StackPanel>

                            <TextBlock Text="Criar Usuário"
                       FontSize="18"
                       FontWeight="Bold"
                       Margin="0,0,0,20"/>

                            <TextBlock Text="Nome"/>
                            <TextBox x:Name="txtNomeUsuario"
                     Height="30"
                     Margin="0,5,0,10"/>

                            <TextBlock Text="Email"/>
                            <TextBox x:Name="txtEmailUsuario"
                     Height="30"
                     Margin="0,5,0,10"/>

                            <TextBlock Text="Senha"/>
                            <PasswordBox x:Name="txtSenhaUsuario"
                         Height="30"
                         Margin="0,5,0,10"/>

                            <TextBlock Text="Tipo"/>
                            <ComboBox x:Name="comboTipoUsuario"
                      Height="30"
                      Margin="0,5,0,20">

                                <ComboBoxItem Content="Admin"/>
                                <ComboBoxItem Content="Funcionario"/>

                            </ComboBox>

                            <Button Content="Salvar Usuário"
                    Height="40"
                    Background="#16A34A"
                    Click="BtnSalvarUsuario_Click"/>

                            <Button Content="Consultar"
                    Height="40"
                    Margin="0,10,0,0"
                    Background="#FF6900"
                    Click="BtnConsultarUsuarios_Click"/>

                            <Button Content="Excluir"
                    Height="40"
                    Margin="0,10,0,0"
                    Background="#C62828"
                    Click="BtnExcluirUsuario_Click"/>

                        </StackPanel>

                    </Border>

                </Grid>

                <!-- ================= FORNECEDORES ================= -->

                <Border x:Name="PainelFornecedores"
        Background="#CCFFFFFF"
        CornerRadius="15"
        Padding="20"
        Visibility="Collapsed">

                    <Grid>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- BOTÕES CRUD -->

                        <StackPanel Orientation="Horizontal"
                    Margin="0,0,0,20">

                            <Button Content="Cadastrar Fornecedor"
                    Padding="20,8"
                    Margin="0,0,10,0"
                    Background="#FF6900"
                    Click="BtnCadastrarFornecedor"/>

                            <Button Content="Editar"
                    Padding="20,8"
                    Margin="0,0,10,0"
                    Background="#FF6900"
                    Click="BtnEditarFornecedor"/>

                            <Button Content="Excluir"
                    Padding="20,8"
                    Margin="0,0,10,0"
                    Background="#C11313"
                    Click="BtnExcluirFornecedor"/>

                            <Button Content="Consultar"
                    Padding="20,8"
                    Background="#FF6900"
                    Click="BtnConsultarFornecedor"/>

                        </StackPanel>

                        <!-- TABELA -->

                        <DataGrid x:Name="gridFornecedores"
                  Grid.Row="1"
                  AutoGenerateColumns="False">

                            <DataGrid.Columns>

                                <DataGridTextColumn Header="ID"
                                    Binding="{Binding Id}"
                                    Width="*"/>

                                <DataGridTextColumn Header="Nome"
                                    Binding="{Binding Nome}"
                                    Width="*"/>

                                <DataGridTextColumn Header="CNPJ"
                                    Binding="{Binding CNPJ}"
                                    Width="*"/>

                                <DataGridTextColumn Header="Telefone"
                                    Binding="{Binding Telefone}"
                                    Width="*"/>

                                <DataGridTextColumn Header="Email"
                                    Binding="{Binding Email}"
                                    Width="*"/>

                            </DataGrid.Columns>

                        </DataGrid>

                    </Grid>

                </Border>

            </Grid>
            

        </Grid>

    </Grid>

</Window>