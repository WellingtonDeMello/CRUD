<Window x:Class="UI.NovoProduto"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:UI"
        mc:Ignorable="d"
        Height="380"
        Width="720"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>

        <!-- TEXTBOX ESTILO (CORRIGIDO) -->
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="35"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Background" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="5">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- COMBOBOX ESTILO -->
        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="35"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Background" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <!-- BOTÃO ESTILO -->
        <Style TargetType="Button">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Window.Background>
        <ImageBrush ImageSource="/1946477-abstrato-azul-e-laranja-moderno-escuro-fundo-gratis-vetor.jpg"/>
    </Window.Background>

    <Grid Margin="30">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ATIVO -->
        <CheckBox Name="boxAtivo"
                  Content="Produto Ativo?"
                  FontSize="14"
                  Foreground="White"
                  Grid.ColumnSpan="2"
                  Margin="0,0,0,10"/>

        <!-- DESCRIÇÃO -->
        <Label Content="Descrição"
               Grid.Column="1"
               Foreground="White"/>

        <TextBox Name="boxDescricao"
                 Grid.Column="1"
                 Margin="3,31,-3,10"
                 MaxLength="30"
                 Background="DarkGray" FontSize="12"/>

        <!-- GRUPO -->
        <Label Content="Grupo"
               Grid.Row="1"
               Foreground="White"/>

        <ComboBox Name="boxGrupo"
                  Grid.Row="1"
                  Margin="1,30,19,10"
                  Background="DarkGray"/>

        <!-- CODIGO BARRAS -->
        <Label Content="Código de Barras"
               Grid.Row="1"
               Grid.Column="1"
               Foreground="White"/>

        <TextBox Name="boxCodBarras"
                 Grid.Row="1"
                 Grid.Column="1"
                 Margin="2,33,-2,7"
                 MaxLength="30"
                 Background="DarkGray"/>

        <!-- UNIDADE -->
        <Label Content="Unidade de Medida"
               Grid.Row="2"
               Foreground="White"/>

        <ComboBox Name="boxUnMedida"
                  Grid.Row="2"
                  Margin="0,33,20,7"
                  Background="DarkGray"/>

        <!-- PREÇO CUSTO -->
        <Label Content="Preço de Custo"
               Grid.Row="2"
               Grid.Column="1"
               Foreground="White"/>

        <TextBox Name="boxPrecoCusto"
                 Grid.Row="2"
                 Grid.Column="1"
                 Margin="0,30,260,10"
                 Background="DarkGray" RenderTransformOrigin="0.48,0.638"/>

        <!-- PREÇO VENDA -->
        <Label Content="Preço de Venda"
               Grid.Row="2"
               Grid.Column="1"
               Margin="220,0,0,0"
               Foreground="White"/>

        <TextBox Name="boxPrecoVenda"
                 Grid.Row="2"
                 Grid.Column="1"
                 Margin="221,31,-1,9"
                 Background="DarkGray"/>

        <!-- BOTÕES -->
        <Button Content="Cancelar"
                Grid.Row="3"
                Grid.Column="1"
                Background="#6B7280"
                Margin="100,10,200,0"
                IsCancel="True"/>

        <Button Content="Confirmar"
                Grid.Row="3"
                Grid.Column="1"
                Background="#FF6900"
                Margin="300,10,0,0"
                Click="btnConfirmarProduto"/>

    </Grid>

</Window>