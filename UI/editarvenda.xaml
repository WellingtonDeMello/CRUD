<Window x:Class="UI.EditarVenda"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Height="320"
        Width="360"
        WindowStartupLocation="CenterScreen"
        Title="Editar Venda"
        ResizeMode="NoResize"
        Background="#1E1E1E">

    <Window.Resources>

        <!-- BOTÃO IGUAL LOGIN -->
        <Style x:Key="RoundedButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="25">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid>

        <Image HorizontalAlignment="Left" Height="309" Margin="-2,-6,0,0" VerticalAlignment="Top" Width="361" Source="/7b7910e2a8267f3a3d52d9120c551e58_processed.jpg" Stretch="Fill"/>

        <StackPanel VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Width="260">

            <!-- NOME -->

            <!-- NOME -->
            <TextBlock Text="Nome do Cliente"
                       Foreground="White"
                       Margin="5" Height="6"/>
            <Label Content="NOME DO CLIENTE" Height="37" Width="260"/>

            <Border CornerRadius="25"
                    Background="DarkGray"
                    BorderBrush="DarkGray"
                    BorderThickness="2"
                    Height="45"
                    Margin="0,0,0,15">

                <TextBox x:Name="boxNome"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="15,0"
                         FontSize="14"
                         Foreground="Black"
                         VerticalContentAlignment="Center"/>
            </Border>
            <TextBlock Text="CPF"
                       Foreground="White" Height="2"
                       />

            <!-- CPF -->
            <Label Content="CPF" Height="36" Width="260"/>

            <Border CornerRadius="25"
                    Background="DarkGray"
                    BorderBrush="DarkGray"
                    BorderThickness="2"
                    Height="45"
                    Margin="0,0,0,20">

                <TextBox x:Name="boxCpf"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="15,0"
                         FontSize="14"
                         Foreground="Black"
                         VerticalContentAlignment="Center"/>
            </Border>

            <!-- BOTÃO -->
            <Button Content="Salvar"
                    Height="45"
                    Background="#FF6900"
                    Style="{StaticResource RoundedButton}"
                    Click="Salvar_Click"/>

        </StackPanel>

    </Grid>
</Window>