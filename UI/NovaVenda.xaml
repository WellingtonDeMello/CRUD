<Window x:Class="UI.NovaVenda"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStartupLocation="CenterScreen"
        MinHeight="720" MinWidth="1024"
        Height="687" Width="963">

    <Window.Resources>

        <!-- BOTÕES -->
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="20">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- TEXTBOX -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#3A3A3A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="12">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>
    <Window.Background>
        <ImageBrush ImageSource="/1946477-abstrato-azul-e-laranja-moderno-escuro-fundo-gratis-vetor.jpg"/>
    </Window.Background>

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="90"/>
            <RowDefinition Height="110"/>
            <RowDefinition Height="110"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="80"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->

        <!-- HEADER -->
        <Border Background="#FF6900"
                CornerRadius="20"
                Padding="20"
                Margin="0,0,0,30">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Nome do Cliente: "
                               FontWeight="Bold"
                               FontSize="16"
                               Foreground="White"/>

                    <TextBlock x:Name="blockNomeCliente"
                               Text="Não Informado"
                               FontSize="16"
                               Foreground="White"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal"
                            Grid.Column="1"
                            HorizontalAlignment="Right">

                    <TextBlock Text="CPF: "
                               FontWeight="Bold"
                               FontSize="16"
                               Foreground="White"/>

                    <TextBlock x:Name="blockCpfCliente"
                               Text="Não Informado"
                               FontSize="16"
                               Foreground="White"/>
                </StackPanel>

            </Grid>

        </Border>

        <!-- CODIGO PRODUTO -->
        <Grid Grid.Row="1" Margin="0,5">

            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <StackPanel Margin="0,0,150,0">
                <Label Content="Digite o Código do Produto" Width="276" Foreground="White"/>
                <TextBox x:Name="boxCodProduto"
                         Height="40"
                         KeyUp="boxCodProduto_KeyUp" Width="270" Background="DarkGray"/>

            </StackPanel>

            <StackPanel Grid.Column="1">

                <Label Content="Produto Pesquisado" Width="444" Foreground="White"/>

                <Border Background="#FF6900"
                        CornerRadius="12"
                        Padding="10" Width="438">

                    <TextBlock x:Name="blockNomeProduto"
                               Foreground="White"
                               FontWeight="Bold"
                               Text="PRODUTO PESQUISADO"/>

                </Border>

            </StackPanel>

        </Grid>

        <!-- QUANTIDADE + OBS -->
        <Grid Grid.Row="2" Margin="0,5">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.ColumnSpan="2" Margin="0,0,650,0">

                <Label Content="Quantidade (Enter)" Foreground="White" Width="238"/>

                <TextBox x:Name="boxQuantidade"
                         Height="40"
                         KeyUp="boxQuantidade_KeyUp" Background="DarkGray" Width="228"/>

            </StackPanel>

            <StackPanel Grid.Column="1" Margin="256,0,0,0">

                <Label Content="Observação (Opcional)" Width="329" Foreground="White"/>

                <TextBox x:Name="boxObs"
                         Height="40" Width="321" Background="DarkGray"/>

            </StackPanel>

        </Grid>

        <!-- GRID (MENOR) -->
        <Border Grid.Row="3"
                Background="White"
                CornerRadius="20"
                Padding="10"
                Margin="0,10">

            <DataGrid x:Name="gridVendaProduto"
                      AutoGenerateColumns="False"
                      Height="260"
                      AlternationCount="{Binding Items.Count, RelativeSource={RelativeSource Mode=Self}}"
                      SelectionChanged="gridVendaProduto_SelectionChanged" Background="{x:Null}" BorderBrush="{x:Null}">

                <DataGrid.Columns>

                    <DataGridTextColumn Binding="{Binding AlternationIndex, RelativeSource={RelativeSource AncestorType={x:Type DataGridRow}}}" Width="0"/>

                    <DataGridTextColumn Header="Código Produto" Binding="{Binding ProdutoId}" Width="1.3*"/>

                    <DataGridTextColumn Header="Nome" Binding="{Binding ProdutoNome}" Width="*"/>

                    <DataGridTextColumn Header="Unidade de Medida" Binding="{Binding UnidadeDeMedida}" Width="1.5*"/>

                    <DataGridTextColumn Header="Preço de Venda" Binding="{Binding PrecoVenda}" Width="1.2*"/>

                    <DataGridTextColumn Header="Quantidade" Binding="{Binding QuantidadeProduto}" Width="*"/>

                    <DataGridTextColumn Header="Total" Binding="{Binding Total}" Width="*"/>

                </DataGrid.Columns>

            </DataGrid>

        </Border>

        <!-- FOOTER -->
        <Grid Grid.Row="4">

            <Grid.ColumnDefinitions>
                <ColumnDefinition/>
                <ColumnDefinition/>
                <ColumnDefinition/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Center">

                <TextBlock Text="Total: "
                           FontWeight="Bold"
                           FontSize="18"/>

                <TextBlock x:Name="blockTotal"
                           Text="0"
                           FontSize="18"/>

            </StackPanel>

            <Button Content="Cancelar"
                    Background="#FFD4150B"
                    Width="200"
                    Height="45"
                    Grid.Column="1"
                    HorizontalAlignment="Left"
                    IsCancel="True" Grid.ColumnSpan="2" Margin="222,16,0,19"/>

            <Button Content="Confirmar Venda"
                    Background="#FF6900"
                    Width="220"
                    Height="45"
                    Grid.Column="2"
                    HorizontalAlignment="Right"
                    Click="btnConfirmarVenda"/>

        </Grid>

    </Grid>

</Window>