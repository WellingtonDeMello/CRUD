<Window x:Class="UI.FormaPagamento"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Forma de Pagamento"
        Height="520"
        Width="420"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen">

    <Window.Background>
        <ImageBrush ImageSource="/1946477-abstrato-azul-e-laranja-moderno-escuro-fundo-gratis-vetor.jpg"
                    Stretch="UniformToFill"/>
    </Window.Background>

    <Grid>

        <!-- CARD CENTRAL -->
        <Border Width="360"
                Padding="25"
                Background="White"
                CornerRadius="15"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

            <ScrollViewer VerticalScrollBarVisibility="Auto">

                <StackPanel>

                    <!-- TOTAL -->
                    <TextBlock x:Name="txtTotal"
                               FontSize="26"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,10"/>

                    <TextBlock Text="ESCOLHA A FORMA DE PAGAMENTO"
                               FontSize="18"
                               FontWeight="SemiBold"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,20"/>

                    <!-- BOTÕES -->
                    <Button Content="Dinheiro"
                            Height="45"
                            Background="#FF6900"
                            Foreground="White"
                            FontSize="16"
                            Margin="0,5"
                            Click="PagamentoDinheiro"/>

                    <Button Content="Cartão"
                            Height="45"
                            Background="#FF6900"
                            Foreground="White"
                            FontSize="16"
                            Margin="0,5"
                            Click="PagamentoCartao"/>

                    <Button Content="Pix"
                            Height="45"
                            Background="#FF6900"
                            Foreground="White"
                            FontSize="16"
                            Margin="0,5"
                            Click="PagamentoPix"/>

                    <!-- DINHEIRO -->
                    <StackPanel x:Name="areaDinheiro"
                                Visibility="Collapsed"
                                Margin="0,20,0,0">

                        <TextBlock Text="Valor recebido:"/>

                        <TextBox x:Name="txtValorRecebido"
                                 Height="35"
                                 Margin="0,5"
                                 TextChanged="CalcularTroco"/>

                        <TextBlock x:Name="txtTroco"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Margin="0,5"/>

                        <Button Content="Concluir Venda"
                                Background="Green"
                                Foreground="White"
                                Height="40"
                                Margin="0,10"
                                Click="FinalizarVenda"/>

                    </StackPanel>

                    <!-- PIX -->
                    <StackPanel x:Name="areaPix"
                                Visibility="Collapsed"
                                Margin="0,20,0,0"
                                HorizontalAlignment="Center">

                        <Image Height="200"
                               Width="200"
                               Source="/Qrcode_wikipedia.jpg"
                               Margin="0,10"/>

                        <TextBlock Text="Escaneie o QR Code"
                                   HorizontalAlignment="Center"/>

                        <Button Content="Pagamento Concluído"
                                Background="Green"
                                Foreground="White"
                                Height="40"
                                Margin="0,10"
                                Click="FinalizarVenda"/>

                    </StackPanel>

                    <!-- CARTÃO -->
                    <StackPanel x:Name="areaCartao"
                                Visibility="Collapsed"
                                Margin="0,20,0,0"
                                HorizontalAlignment="Center">

                        <TextBlock Text="Passe o cartão na máquina"
                                   FontSize="16"
                                   FontWeight="Bold"
                                   Margin="0,10"/>

                        <Button Content="Pagamento Aprovado"
                                Background="Green"
                                Foreground="White"
                                Height="40"
                                Margin="0,10"
                                Click="FinalizarVenda"/>

                    </StackPanel>

                </StackPanel>

            </ScrollViewer>

        </Border>

    </Grid>

</Window>