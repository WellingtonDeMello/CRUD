<Window x:Class="UI.Login"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Login"
        Height="467"
        Width="350"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">

    <Window.Resources>


        <Style x:Key="RoundedButton" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="25">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid>
        <Grid.Background>
            <ImageBrush ImageSource="/1946477-abstrato-azul-e-laranja-moderno-escuro-fundo-gratis-vetor.jpg"
                        Stretch="Fill"/>
        </Grid.Background>

        <StackPanel VerticalAlignment="Top"
                    HorizontalAlignment="Left"
                    Width="268" Margin="36,134,0,0">


            <Border CornerRadius="25"
                    Background="DarkGray"
                    BorderBrush="DarkGray"
                    BorderThickness="2"
                    Height="50"
                    Margin="0,0,0,15" Width="271">

                <Grid Background="DarkGray" Margin="14,4,35,2">
                    <TextBox x:Name="emailBox"
                             Background="Transparent"
                             BorderThickness="0"
                             Padding="20,0"
                             FontSize="20"
                             Foreground="Black"
                             VerticalContentAlignment="Center"
                             TextChanged="emailBox_TextChanged"/>

                    <TextBlock x:Name="emailPlaceholder"
                               Text="Digite seu e-mail"
                               Foreground="Black"
                               Margin="20,0,0,0"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False"/>
                </Grid>
            </Border>


            <Border CornerRadius="25"
                    Background="DarkGray"
                    BorderBrush="DarkGray"
                    BorderThickness="2"
                    Height="50"
                    Margin="0,0,0,20">

                <Grid Width="219" Background="#FF373535">
                    <PasswordBox x:Name="passBox"
                                 Background="DarkGray"
                                 BorderThickness="0"
                                 Padding="20,0"
                                 FontSize="14"
                                 Foreground="Black"
                                 VerticalContentAlignment="Center"
                                 PasswordChanged="passBox_PasswordChanged" Margin="-1,0,-5,0"/>

                    <TextBlock x:Name="senhaPlaceholder"
                               Text="Digite sua senha"
                               Foreground="Black"
                               Margin="12,0,8,0"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False"/>
                </Grid>
            </Border>

            <Button Content="Entrar"
                    Height="50"
                    Margin="0,0,0,10"
                    Background="#FF6900"
                    Style="{StaticResource RoundedButton}"
                    Click="btnEntrar"/>

            <Button Content="Voltar"
                    Height="51"
                    Margin="0,0,0,10"
                    Background="#084CBB"
                    Style="{StaticResource RoundedButton}"
                    Click="btnNovo"/>

        </StackPanel>
        <Image HorizontalAlignment="Left" Height="155" Margin="95,-10,0,0" VerticalAlignment="Top" Width="153" Source="/ChatGPT Image 27 de jan. de 2026, 19_20_51.png"/>

    </Grid>
</Window>